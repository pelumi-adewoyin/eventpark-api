# Copy this to .env and fill in your values

# Server
PORT=8080
ENV=development

# PostgreSQL (from Railway)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=another-random-secret-for-refresh-tokens

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...

# Dojah (https://app.dojah.io/dashboard)
DOJAH_APP_ID=your-dojah-app-id
DOJAH_PRIVATE_KEY=your-dojah-private-key

# SMS (Termii — https://termii.com — easier for Nigerian numbers)
TERMII_API_KEY=your-termii-api-key
